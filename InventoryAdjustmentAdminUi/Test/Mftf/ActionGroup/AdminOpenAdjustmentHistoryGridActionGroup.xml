<actionGroups xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/actionGroupSchema.xsd">
    <actionGroup name="AdminOpenAdjustmentHistoryGridActionGroup">
        <annotations>
            <description>Opens the global adjustment history grid with the saved filters cleared.</description>
        </annotations>

        <amOnPage url="{{AdminAdjustmentHistoryPage.url}}" stepKey="openAdjustmentHistoryGrid"/>
        <waitForPageLoad stepKey="waitForAdjustmentHistoryGrid"/>
        <waitForElementVisible selector="{{AdminAdjustmentHistoryGridSection.table}}" stepKey="waitForTheGridToRender"/>
        <scrollToTopOfPage stepKey="scrollToTop"/>
        <conditionalClick selector="{{AdminDataGridFilterSection.clear}}" dependentSelector="{{AdminDataGridFilterSection.clear}}" visible="true" stepKey="clearSavedFilters"/>
        <waitForPageLoad stepKey="waitForFiltersCleared"/>
    </actionGroup>
</actionGroups>
