---
import Diagram from '../Diagram.astro';
---

<Diagram caption="Three seams feed one decider. Only the panel's own cache tag, inv_stockviz_<productId>, is purged: right away when the inventory index runs on save, through the queue when it runs on schedule.">
	<svg viewBox="0 0 720 230" role="img" aria-labelledby="sp-title">
		<title id="sp-title">How the stock visualizer keeps its cached panel fresh</title>
		<defs>
			<marker id="sp-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
				<path class="head" d="M0,0 L10,5 L0,10 z" />
			</marker>
		</defs>

		<rect class="box" x="10" y="10" width="160" height="50" rx="6" />
		<text class="title" x="90" y="31" text-anchor="middle">Demand</text>
		<text class="sub" x="90" y="48" text-anchor="middle">reservation writes</text>
		<rect class="box" x="10" y="90" width="160" height="50" rx="6" />
		<text class="title" x="90" y="111" text-anchor="middle">Supply</text>
		<text class="sub" x="90" y="128" text-anchor="middle">source item save, delete</text>
		<rect class="box" x="10" y="170" width="160" height="50" rx="6" />
		<text class="title" x="90" y="191" text-anchor="middle">Salability</text>
		<text class="sub" x="90" y="208" text-anchor="middle">flips during reindex</text>

		<path class="edge" d="M170,35 C190,35 182,115 200,115" />
		<path class="edge" d="M170,115 H208" marker-end="url(#sp-arrow)" />
		<path class="edge" d="M170,195 C190,195 182,115 200,115" />

		<rect class="box accent" x="210" y="90" width="160" height="50" rx="6" />
		<text class="mono accent-text" x="290" y="111" text-anchor="middle">ResolveSkusToPurge</text>
		<text class="sub accent-text" x="290" y="128" text-anchor="middle">enabled, display rules</text>

		<path class="edge" d="M370,115 H403" marker-end="url(#sp-arrow)" />

		<rect class="box accent" x="405" y="90" width="130" height="50" rx="6" />
		<text class="mono accent-text" x="470" y="111" text-anchor="middle">DispatchPurge</text>
		<text class="sub accent-text" x="470" y="128" text-anchor="middle">follows the indexer</text>

		<rect class="box" x="570" y="40" width="140" height="50" rx="6" />
		<text class="title" x="640" y="61" text-anchor="middle">Purge now</text>
		<text class="sub" x="640" y="78" text-anchor="middle">index on save</text>
		<rect class="box" x="570" y="140" width="140" height="50" rx="6" />
		<text class="title" x="640" y="161" text-anchor="middle">Queue</text>
		<text class="sub" x="640" y="178" text-anchor="middle">index on schedule</text>

		<path class="edge" d="M535,108 C552,108 550,65 568,65" marker-end="url(#sp-arrow)" />
		<path class="edge" d="M535,122 C552,122 550,165 568,165" marker-end="url(#sp-arrow)" />
	</svg>
</Diagram>
