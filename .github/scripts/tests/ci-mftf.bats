#!/usr/bin/env bats

setup() {
    MAGENTO="$BATS_TEST_TMPDIR/magento"
    BIN="$BATS_TEST_TMPDIR/bin"
    CALLS="$BATS_TEST_TMPDIR/php-calls"
    REPORT="$BATS_TEST_TMPDIR/report"
    GENERATED="$MAGENTO/dev/tests/acceptance/tests/functional/Magento/_generated"
    mkdir -p "$MAGENTO/dev/tests/acceptance/tests/_output/allure-results" "$GENERATED/stale" "$BIN"
    echo failure > "$MAGENTO/dev/tests/acceptance/tests/_output/a.fail.html"
    echo AdminBetaTest > "$BATS_TEST_TMPDIR/selection"
    cat > "$BIN/php" <<'STUB'
#!/bin/sh
echo "$*" >> "$CALLS"
case "$*" in
    *ci-mftf-select.php*) cat "$SELECTION" ;;
    *"generate:tests --force "*) test ! -e "$GENERATED/stale" || { echo "stale generated tests were kept" >&2; exit 1; } ;;
    *run:manifest*) exit "${MANIFEST_STATUS:-0}" ;;
esac
STUB
    chmod +x "$BIN/php"
    SCRIPT="$BATS_TEST_DIRNAME/../ci-mftf.sh"
    PATH="$BIN:$PATH"
    export CALLS SELECTION="$BATS_TEST_TMPDIR/selection" GENERATED
}

@test "generates every test first, so MFTF resolves which suite each one belongs to" {
    run sh "$SCRIPT" "$MAGENTO" 1 4 "$REPORT"

    [ "$status" -eq 0 ]
    [ "$(grep -c 'generate:tests' "$CALLS")" -eq 2 ]
    [[ "$(grep -m1 'generate:tests' "$CALLS")" == *"generate:tests --force" ]]
}

@test "asks the selector for its shard of the generated tests" {
    run sh "$SCRIPT" "$MAGENTO" 3 20 "$REPORT"

    [ "$status" -eq 0 ]
    grep "ci-mftf-select.php" "$CALLS" | grep -qE " 3 20$"
}

@test "passes the test list and the group on to the selector" {
    run sh "$SCRIPT" "$MAGENTO" 1 1 "$REPORT" --tests "AdminBetaTest" --group multi_mode

    [ "$status" -eq 0 ]
    grep -qF -- "1 1 --tests AdminBetaTest --group multi_mode" "$CALLS"
}

@test "generates only the selection, from a clean directory, and runs its manifest" {
    run sh "$SCRIPT" "$MAGENTO" 1 4 "$REPORT"

    [ "$status" -eq 0 ]
    grep -qE 'generate:tests --force AdminBetaTest$' "$CALLS"
    grep -qF "run:manifest $GENERATED/testManifest.txt" "$CALLS"
}

@test "names every selected test as an argument, so MFTF never falls back to generating all of them" {
    printf '%s\n' AdminBetaTest InventoryMultiModeSuite:AdminAlphaTest InventorySingleModeSuite:AdminGammaTest > "$SELECTION"

    run sh "$SCRIPT" "$MAGENTO" 2 4 "$REPORT"

    [ "$status" -eq 0 ]
    grep -qF 'generate:tests --force AdminBetaTest InventoryMultiModeSuite:AdminAlphaTest InventorySingleModeSuite:AdminGammaTest' "$CALLS"
    ! grep -qF -- '--tests {' "$CALLS"
}

@test "names the suite tests as arguments when the shard holds suite tests only" {
    printf '%s\n' InventoryMultiModeSuite:AdminAlphaTest InventorySingleModeSuite:AdminGammaTest > "$SELECTION"

    run sh "$SCRIPT" "$MAGENTO" 17 20 "$REPORT"

    [ "$status" -eq 0 ]
    grep -qF 'generate:tests --force InventoryMultiModeSuite:AdminAlphaTest InventorySingleModeSuite:AdminGammaTest' "$CALLS"
    grep -qF "run:manifest" "$CALLS"
}

@test "runs nothing when the shard has no test" {
    : > "$SELECTION"

    run sh "$SCRIPT" "$MAGENTO" 4 4 "$REPORT"

    [ "$status" -eq 0 ]
    ! grep -q "run:manifest" "$CALLS"
    [[ "$output" == *"no MFTF test"* ]]
}

@test "fails when the selector fails" {
    printf '#!/bin/sh\ncase "$*" in *ci-mftf-select.php*) echo "not generated by MFTF" >&2; exit 1;; esac\n' > "$BIN/php"

    run sh "$SCRIPT" "$MAGENTO" 1 4 "$REPORT" --tests NoSuchTest

    [ "$status" -eq 1 ]
    [[ "$output" == *"not generated by MFTF"* ]]
}

@test "keeps the output of the run in the report directory, whatever the result" {
    MANIFEST_STATUS=1 run sh "$SCRIPT" "$MAGENTO" 1 4 "$REPORT"

    [ "$status" -eq 1 ]
    [ -f "$REPORT/_output/a.fail.html" ]
    [ -d "$REPORT/_output/allure-results" ]
}

@test "requires the Magento directory, the shard, the shard count and the report directory" {
    run sh "$SCRIPT" "$MAGENTO" 1 4

    [ "$status" -ne 0 ]
}

retry_setup() {
    printf '%s\n' InventoryMultiModeSuite:AdminBetaTest StorefrontGammaTest > "$BATS_TEST_TMPDIR/failed"
    cat > "$BIN/php" <<'STUB'
#!/bin/sh
echo "$*" >> "$CALLS"
case "$*" in
    *ci-mftf-select.php*) cat "$SELECTION" ;;
    *ci-mftf-retry.php*" failed "*) cat "$FAILED" ;;
    *ci-mftf-retry.php*" flaky "*) echo "flaky section" ;;
    *run:manifest*)
        runs=$(grep -c "run:manifest" "$CALLS")
        if [ "$runs" -eq 1 ]; then exit "${MANIFEST_STATUS:-0}"; fi
        exit "${RETRY_STATUS:-0}" ;;
esac
STUB
    export FAILED="$BATS_TEST_TMPDIR/failed"
}

@test "does not retry when the run passes" {
    retry_setup

    run sh "$SCRIPT" "$MAGENTO" 1 4 "$REPORT"

    [ "$status" -eq 0 ]
    [ "$(grep -c 'run:manifest' "$CALLS")" -eq 1 ]
}

@test "retries only the tests that failed, from a clean generated directory" {
    retry_setup

    MANIFEST_STATUS=1 run sh "$SCRIPT" "$MAGENTO" 1 4 "$REPORT"

    [ "$status" -eq 0 ]
    [ "$(grep -c 'run:manifest' "$CALLS")" -eq 2 ]
    grep -qE 'generate:tests --force InventoryMultiModeSuite:AdminBetaTest StorefrontGammaTest$' "$CALLS"
}

@test "passes when the failed tests pass on the retry" {
    retry_setup

    MANIFEST_STATUS=1 RETRY_STATUS=0 run sh "$SCRIPT" "$MAGENTO" 1 4 "$REPORT"

    [ "$status" -eq 0 ]
}

@test "fails when a test fails on the retry too" {
    retry_setup

    MANIFEST_STATUS=1 RETRY_STATUS=1 run sh "$SCRIPT" "$MAGENTO" 1 4 "$REPORT"

    [ "$status" -eq 1 ]
}

@test "fails without a retry when the run left no failed test to retry" {
    retry_setup
    : > "$FAILED"

    MANIFEST_STATUS=1 run sh "$SCRIPT" "$MAGENTO" 1 4 "$REPORT"

    [ "$status" -eq 1 ]
    [ "$(grep -c 'run:manifest' "$CALLS")" -eq 1 ]
}

@test "writes the flaky tests to the step summary" {
    retry_setup

    GITHUB_STEP_SUMMARY="$BATS_TEST_TMPDIR/summary" MANIFEST_STATUS=1 run sh "$SCRIPT" "$MAGENTO" 5 20 "$REPORT"

    [ "$status" -eq 0 ]
    grep -q "flaky section" "$BATS_TEST_TMPDIR/summary"
    grep -qE 'ci-mftf-retry.php flaky .* 5$' "$CALLS"
}

@test "keeps the first run's results next to the retry's in the report" {
    retry_setup
    echo first > "$MAGENTO/dev/tests/acceptance/tests/_output/allure-results/first-result.json"

    MANIFEST_STATUS=1 run sh "$SCRIPT" "$MAGENTO" 1 4 "$REPORT"

    [ "$status" -eq 0 ]
    [ -f "$REPORT/_output/allure-results/first-result.json" ]
}
